# @assurance:evidence db-id-exact-match
# ID でタスクを探すときは、文字どおりに一致するタスクがあれば必ず見つけ、一致しなければ見つけない。空の ID、形の違う ID、大文字を含む ID は、どのタスクとも一致しない
# 登録した ID を大文字にしたもので探す場合は、ID が毎回ランダムで台本に書けないので、DB のインターフェースのテストで確かめる
env QUENTA_SESSION=session-1
env XDG_DATA_HOME=$WORK/data
exec quenta task add --title 探す
setjson ID task.id

# 文字どおりに一致する ID なら見つかる
exec quenta task show $ID
stdout '"title":"探す"'

# 空の ID
! exec quenta task show ''
stdout '"code":"not_found"'

# 登録した ID の後ろに 1 文字足したもの（9 桁）
! exec quenta task show ${ID}0
stdout '"code":"not_found"'

# 16 進でない文字を含む ID
! exec quenta task show zzzzzzzz
stdout '"code":"not_found"'

# 大文字を含む ID
! exec quenta task show 0123ABCD
stdout '"code":"not_found"'

# 完了・中止でも、一致しない ID は見つからない
! exec quenta task done ${ID}0 --reason 済んだ
stdout '"code":"not_found"'
! exec quenta task cancel '' --reason 要らない
stdout '"code":"not_found"'

# 完了でも、文字どおりに一致する ID なら見つかる
exec quenta task done $ID --reason 済んだ
stdout '"status":"done"'
