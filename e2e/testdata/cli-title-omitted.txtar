# @assurance:evidence cli-title-omitted
# --title を省くと（値なしで最後に置いた場合を含む）、タイトルは空として渡り、title_required になる
env QUENTA_SESSION=session-1
env XDG_DATA_HOME=$WORK/data

# --title を省く
! exec quenta task add --body 本文だけ
stdout '^\{"error":\{"code":"title_required","message":"[^"]+"\}\}$'

# --title を値なしで最後に置く
! exec quenta task add --body 本文 --title
stdout '^\{"error":\{"code":"title_required","message":"[^"]+"\}\}$'

# どちらも登録されていない
exec quenta task list --all
cmp stdout empty.json

-- empty.json --
{"tasks":[]}
