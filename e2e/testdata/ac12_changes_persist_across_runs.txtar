# AC12: 別々に CLI を起動しても、登録したタスクと状態の変更が残っている
# （台本の exec は、毎回 CLI を別のプロセスとして起動する）

env QUENTA_SESSION=session-1
exec quenta task add --title A
setjson A task.id
setjson A_AT task.created_at
exec quenta task add --title B
setjson B task.id
setjson B_AT task.created_at
exec quenta task done $A --reason 済んだ

exec quenta task list --all
cmpenv stdout list.json

exec quenta task show $A
stdout '"to":"done","reason":"済んだ"'

-- list.json --
{"tasks":[{"id":"$A","title":"A","status":"done","created_at":"$A_AT"},{"id":"$B","title":"B","status":"todo","created_at":"$B_AT"}]}
