# AC13: データは XDG_DATA_HOME の下にだけ作られ、カレントディレクトリには何も作られない
# （HOME と XDG_DATA_HOME は、台本ごとの一時ディレクトリの下の別々の場所を指している）

env QUENTA_SESSION=session-1
mkdir cwd
cd cwd

exec quenta task add --title A --body b
setjson ID task.id
exec quenta task list
exec quenta task show $ID
exec quenta task done $ID --reason 済んだ
! exec quenta task add --title ''

# カレントディレクトリと HOME には何もない
exec ls -A
! stdout .
exec ls -A $HOME
! stdout .

# XDG_DATA_HOME の下には quenta/quenta.db だけがある（SQLite が一時的に作る -wal・-shm は、閉じるときに消える）
exec ls -A $XDG_DATA_HOME
cmp stdout $WORK/quenta_dir.txt
exec ls -A $XDG_DATA_HOME/quenta
cmp stdout $WORK/db_file.txt

# XDG_DATA_HOME が未設定なら、HOME の下の .local/share/quenta にだけ作られる
env XDG_DATA_HOME=
exec quenta task add --title B
exec ls -A
! stdout .
exec ls -A $HOME/.local/share/quenta
cmp stdout $WORK/db_file.txt

-- quenta_dir.txt --
quenta
-- db_file.txt --
quenta.db
